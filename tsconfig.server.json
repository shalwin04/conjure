{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "api/**/*.ts", "src/spec/**/*.ts", "src/engine/tip.ts", "src/engine/verbs.ts", "src/engine/playtest.ts", "src/engine/transform.ts"]
}
